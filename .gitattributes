# Auto-detect text files and normalize line endings
* text=auto

# Python source
*.py text diff=python

# Jupyter notebooks
*.ipynb text diff=jupyter

# Markdown documentation
*.md text
*.rst text

# Config files
*.yml text
*.yaml text
*.toml text
*.json text
*.cfg text
*.ini text
*.env text
*.env.template text

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf

# Docker
Dockerfile text
Dockerfile.* text

# Requirements
requirements.txt text
runtime.txt text

# Data files
*.csv text

# Binary / ML model files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.pickle binary
*.npy binary
*.npz binary
*.zip binary
