# Auto-detect text files and normalize line endings
* text=auto

# Python source
*.py text diff=python

# Jupyter notebooks
*.ipynb text diff=jupyter

# Markdown documentation
*.md text
*.rst text

# Config files
*.yml text
*.yaml text
*.toml text
*.json text
*.cfg text
*.ini text
*.env text

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf

# Docker
Dockerfile text
Dockerfile.* text

# Requirements
requirements.txt text
runtime.txt text

# Data files — datasets are large (tags.csv is ~67MB) and belong in Git LFS.
# NOTE: `*.csv text` was removed deliberately — LFS rules must own these files
# (a `text` attribute on an LFS-tracked file corrupts checkout semantics).
*.csv filter=lfs diff=lfs merge=lfs -text

# ML model artifacts — meta.joblib is ~56MB (tracked for deployment per .gitignore)
*.joblib filter=lfs diff=lfs merge=lfs -text

# Binary / ML model files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.pickle binary
*.npy binary
*.npz binary
*.zip binary
