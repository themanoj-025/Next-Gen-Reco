# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python source
*.py text diff=python

# Jupyter notebooks
*.ipynb text diff=jupyter

# Markdown documentation
*.md text
*.rst text

# Config files
*.yml text
*.yaml text
*.toml text
*.json text
*.cfg text
*.ini text

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.env.* -diff
*.pem -diff
*.key -diff
*.cert -diff
*.crt -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff
*.kdbx -diff
*id_rsa* -diff
*id_ed25519* -diff
*credentials*.json -diff
*client_secret*.json -diff
*service-account*.json -diff
*token*.json -diff

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Docker
Dockerfile text
Dockerfile.* text
.dockerignore text

# Requirements
requirements.txt text
requirements*.txt text
runtime.txt text

# Data files — datasets are large (tags.csv is ~67MB) and belong in Git LFS.
*.csv filter=lfs diff=lfs merge=lfs -text

# Parquet siblings migrated from the tracked CSVs (migrate_to_parquet.py); also LFS
*.parquet filter=lfs diff=lfs merge=lfs -text

# ML model artifacts — meta.joblib is ~56MB (tracked for deployment per .gitignore)
*.joblib filter=lfs diff=lfs merge=lfs -text

# Binary / ML model files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.pickle binary
*.npy binary
*.npz binary
*.zip binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Archive export ignores: exclude development, CI, and test tooling from release archives
.github/ export-ignore
.gitleaks.toml export-ignore
.pre-commit-config.yaml export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.git-blame-ignore-revs export-ignore
.gitmessage export-ignore
tests/ export-ignore
