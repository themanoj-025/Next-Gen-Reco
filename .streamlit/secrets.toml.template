# ═══════════════════════════════════════════════════════════════════════════
#  Streamlit Cloud Secrets  —  https://share.streamlit.io/
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file to secrets.toml:
#    cp .streamlit/secrets.toml.template .streamlit/secrets.toml
#
# 2. For LOCAL development: edit .streamlit/secrets.toml with your keys
#    (secrets.toml is gitignored — safe to commit secrets.template)
#
# 3. For Streamlit Cloud deployment:
#    Go to your app → ⋮ menu → Settings → Secrets
#    Paste the contents below (without comments)

# ── TMDB API (for movie posters and metadata) ──────────────────────────────
# Get a free API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY = "your_tmdb_api_key_here"

# ── Optional: Streamlit Cloud app management ──────────────────────────────
# These are automatically set by Streamlit Cloud, but you can override:
# IS_DEPLOYMENT = "true"
