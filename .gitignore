# ==============================================================================
# Next-Gen-Reco - Security & Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS & ENVIRONMENT VARIABLES (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample

# Streamlit secrets (NEVER commit!)
.streamlit/secrets.toml
.streamlit/secrets.toml.local
!.streamlit/secrets.toml.template
!.streamlit/secrets.toml.example
.movie_user_data.json

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
credentials.json
*credentials*.json
client_secret*.json
client_secrets*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
google-credentials*.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.secrets.*
.secrets
*.publishsettings
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
kubeconfig
*.kubeconfig
.kube/

# Password vaults & cryptographic stores
*.kdbx

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ------------------------------------------------------------------------------
# 2. PYTHON RUNTIME, BUILDS & VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.class
*.so
.Python
dist/
build/
*.egg-info/

# Virtual environments
env/
venv/
.venv/
ENV/
.venv*/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. LARGE DATA & MODEL ARTIFACTS
# ------------------------------------------------------------------------------
# ratings.csv is 857MB — must NOT be tracked in git
data/ratings.csv
# Full MovieLens 32M dataset
data/rating_*.csv
data/genome*

# The migrated CSVs stay on disk locally but are no longer tracked in git
data/movies.csv
data/tags.csv
data/ND/movies.csv

# ML model artifacts (general patterns)
*.pkl
*.h5
*.pt
*.ckpt
*.parquet
mlruns/

# Specific generated/junk model files
*.bak.joblib
*.tmp.joblib
models/scratch*

# Negation exceptions: Parquet siblings migrated from tracked CSVs ARE tracked
!data/*.parquet
!data/ND/*.parquet

# Production models in models/v1_test/ are tracked in git for deployment
!models/v1_test/*.joblib

# ------------------------------------------------------------------------------
# 4. LOGS & DATABASE FILES
# ------------------------------------------------------------------------------
logs/
*.log
*.dump
*.stackdump
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sql.gz
*.rdb

# ------------------------------------------------------------------------------
# 5. TESTING & CODE QUALITY
# ------------------------------------------------------------------------------
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
radar_balance.txt

# ------------------------------------------------------------------------------
# 6. IDE, EDITORS & JUPYTER
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
.idea/
*.ipynb
*.swp
*.swo
*~
split_app.py
checksums.txt
README.txt
.streamlit/*.local.toml

# ------------------------------------------------------------------------------
# 7. OS FILES & TEMPORARIES
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
nul
*.tmp
*.temp
*.bak

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================================
# KEEP: AI provenance & transparency files — must remain visible
# =====================================================================
!AI_DISCLOSURE.md
!AI_USAGE.md
!PROMPTS.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.github/copilot-instructions.md
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/settings.json
!docs/ai/
!docs/ai/**
!.ai/
!.ai/**
!ai-provenance.json
!.gitmessage
!CITATION.cff
